# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (/admin)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=a-long-random-string-used-to-sign-the-admin-session-cookie

# Public site URL, used for metadata, OpenGraph, and the sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: ISO 8601 launch date/time for the countdown. Defaults to a
# built-in date if unset.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-01T00:00:00-04:00
