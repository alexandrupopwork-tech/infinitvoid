# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (/admin)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=a-long-random-string-used-to-sign-the-admin-session-cookie

# Resend — sends the "Welcome to the void" confirmation email when someone
# joins the waitlist. Get the API key from resend.com/api-keys. The from
# address must be on a domain you've verified in Resend (Domains tab);
# until then you can test with onboarding@resend.dev.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=hello@your-domain.com

# Public site URL, used for metadata, OpenGraph, and the sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: ISO 8601 launch date/time for the countdown. Defaults to a
# built-in date if unset.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-01T00:00:00-04:00

# Stripe — dashboard.stripe.com/apikeys. Use test keys (pk_test_/sk_test_)
# until you're ready to charge real cards, then swap in the live pair.
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional: only needed if you wire up a webhook endpoint (dashboard.stripe.com
# -> Developers -> Webhooks -> add endpoint at <site>/api/webhooks/stripe,
# listening for checkout.session.completed). Not required for checkout to
# work — the success page records orders and sends the confirmation email
# on its own; the webhook is a more robust backup path for production.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# The buy button stays hidden until this is explicitly set to "true" — flip
# it on only when you're ready for real visitors to be able to check out.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Optional: only needed if you wire up Instagram DM/comment auto-replies
# (app/api/webhooks/instagram/route.ts). See the setup steps at the top of
# that file — you need a Meta Developer app with an Instagram professional
# account connected to a Facebook Page.
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_VERIFY_TOKEN=choose-any-random-string-yourself
