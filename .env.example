# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (/admin)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=a-long-random-string-used-to-sign-the-admin-session-cookie

# Resend — sends the "Welcome to the void" confirmation email when someone
# joins the waitlist. Get the API key from resend.com/api-keys. The from
# address must be on a domain you've verified in Resend (Domains tab);
# until then you can test with onboarding@resend.dev.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=hello@your-domain.com

# Public site URL, used for metadata, OpenGraph, and the sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: ISO 8601 launch date/time for the countdown. Defaults to a
# built-in date if unset.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-01T00:00:00-04:00
